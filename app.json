{
  "expo": {
    "name": "IzzyDrive",
    "slug": "IzzyDrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.izzydrive.app",
      "infoPlist": {
        "NSCameraUsageDescription": "IzzyDrive needs camera access to monitor for drowsiness while driving.",
        "NSLocationWhenInUseUsageDescription": "IzzyDrive needs location access to measure your driving speed.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "IzzyDrive needs background location access to monitor your speed while the screen is dimmed.",
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.izzydrive.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "IzzyDrive needs camera access to monitor for drowsiness."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "IzzyDrive needs location access to measure driving speed.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
